# OceanTrace AI — deployment settings and secrets (copy to .env; never commit .env)
# All variables are optional; defaults are shown. Prefix OT_ is required.

# Where scenes, cases, artifacts, fixtures and the SQLite DB live
#OT_DATA_DIR=./data
# Algorithm parameters (versioned YAML; every case stores a resolved snapshot + hash)
#OT_CONFIG_PATH=./configs/default.yaml
# SQLite file (defaults to <OT_DATA_DIR>/oceantrace.sqlite)
#OT_DB_PATH=

# API bind
#OT_HOST=0.0.0.0
#OT_PORT=8000
# Background job workers (detection/hindcast/attribution run in-process threads)
#OT_MAX_WORKERS=2
#OT_LOG_LEVEL=INFO

# Land mask (Natural Earth 10 m by default; point at another WKB built with tools/build_landmask.py)
#OT_LANDMASK_PATH=./data/static/ne_10m_land.wkb

# --- External providers (keys are read server-side only; never sent to the browser) ---
# Live AIS recorder (aisstream.io, free key: https://aisstream.io). Without it the
# "Start recording" button reports that live AIS is unavailable; CSV import still works.
#OT_AISSTREAM_API_KEY=
# Reserved for a historical AIS provider adapter (not wired yet)
#OT_DATALASTIC_API_KEY=

# Open-Meteo (met-ocean forcing) and Microsoft Planetary Computer (Sentinel-1 GRD catalog)
# are used anonymously — no keys required.
